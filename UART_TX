timescale 1ns / 1ps


module UART_tx(

input clk,
input reset,

input  send,
input  [7:0]data_tx,

output reg serial_data,
output reg done



);


 

// let baud rate 100 and sys clk hz 200 then it takes abt 2 clk cycles for 1 bit
parameter baud_rate = 2500000;
parameter clk_freq = 5000000;

parameter clk_bit = clk_freq/baud_rate;

parameter IDLE = 2'b00;
parameter START = 2'b01;
parameter DATA = 2'b10;
parameter STOP = 2'b11;



reg [1:0] state;
reg [3:0] counter_clk;
reg [3:0] index;
reg [8:0] tx_data;
reg parity_bit;

//assign parity_bit = data_tx[0]+data_tx[1]+data_tx[2]+data_tx[3]+data_tx[4]+data_tx[5]+data_tx[6]+data_tx[7];


always@(posedge clk or posedge reset) begin


   if(reset) begin
   counter_clk <= 4'd0;
   index <= 4'd0;
   state <= IDLE;
   tx_data <= 9'd0;
   serial_data <= 1'b1;
   done <= 1'b0;
   
   

   end
    
     
   else begin
   done <= 1'b0;
   parity_bit = data_tx[0]+data_tx[1]+data_tx[2]+data_tx[3]+data_tx[4]+data_tx[5]+data_tx[6]+data_tx[7];
   
   case(state)
   
   IDLE: begin
   
   serial_data <= 1'b1;
   index <= 4'b0;
   
   if(send) begin
   state <= START;
   counter_clk <= 4'b0;
   tx_data[7:0] <= data_tx;
   tx_data[8] <= parity_bit;
   
      end
   end
   
   START: begin
   serial_data <= 1'b0;
   index = 3'b0;
   
   if(counter_clk == clk_bit - 1) begin
   state <= DATA;
   counter_clk <= 0;
   
   end
   else begin
   counter_clk <= counter_clk + 1;
   end
   
   end
   
   DATA: begin
   
   serial_data <= tx_data[index];
   
   if(counter_clk == clk_bit - 1) begin
   
    counter_clk = 0;
   
      if(index == 8) begin
      state <= STOP;
      end
      else begin
      index <= index+1;
      end
   

   end
   
   else begin
    counter_clk <= counter_clk +1;
   
   end
   

   end
   
   STOP: begin
   serial_data <= 1;
   index <= 0;
   if(counter_clk == clk_bit-1) begin
   
   state <= IDLE;
   end
   
   else begin
   counter_clk <= counter_clk +1;
   end
   
   end
   

   endcase

  end


end



endmodule
