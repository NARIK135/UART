timescale 1ns / 1ps
module UART_rx(
input clk_rx,
input reset,
input serial_data,

output reg [8:0]data_rx,
output reg recevied
);



parameter baud_rate = 2500000;
parameter clk_freq = 5000000;

parameter clk_bit = clk_freq/baud_rate;

parameter idle = 3'b000;
parameter start = 3'b001;
parameter data = 3'b010;
parameter stop = 3'b100;

reg [2:0]state;
reg [3:0]counter_clk;
reg [3:0]index;
reg [8:0]rx_data;


always@(posedge clk_rx or posedge reset) begin


  
if(reset) begin

counter_clk <= 4'b0;
   index <= 4'b0;
   state <= idle;
   rx_data <= 8'b0;
   recevied <= 1'b0;
   data_rx <= rx_data;
   


end

else begin



 case(state)
   
   
    idle: begin
    
      if(serial_data == 1'b0) begin
      
        state <= start;
        counter_clk <= 4'b0;
      
      end
      end
      
    start: begin
    
    
       if(counter_clk == (clk_bit/2)-1) begin
       
         if(serial_data == 1'b0) begin
          
             state <= data;
               counter_clk <= 0;
                 index<= 0;
           end
           
           
           else begin
             state <= idle;
           end
           
       end
      
          
          else begin
             counter_clk <= counter_clk+1;        
          end
       
       end
         
      data: begin
      
      if(counter_clk == clk_bit-1)begin
       
        counter_clk <= 0;
        rx_data[index] <= serial_data;
      
      
        if (index == 8) begin
         state <= stop; 
        end
        else begin
         index <= index+1;
        end
     
     end
     
     else begin
     counter_clk <= counter_clk+1;
     end


      end
      
      stop : begin
      
      if(counter_clk == clk_bit - 1) begin
      state <= idle;
      counter_clk <= 0;
      recevied <= 1;
      data_rx <= rx_data;
      
      
      end
      else begin
        
         counter_clk <= counter_clk + 1;
             
      end
      
      end
      
      default: state <= idle;


 endcase

end

end



endmodule
