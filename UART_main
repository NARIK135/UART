`timescale 1ns / 1ps

module UART(
input clk,
input reset,

input [7:0]data_tx,

input sent,
output recevied,
output [8:0]data_rx

    );
    
   // localparam clk_bit = 2;
    
     //parameter baud_rate = 2500000;
    // parameter clk_freq = 5000000;

    // parameter clk_bit = clk_freq/baud_rate;
    
    wire serial_data;
    wire done;
   
    
    
    UART_tx uart_tx(clk,reset,sent,data_tx,serial_data,done);
    
    UART_rx uart_rx(clk,reset,serial_data,data_rx,recevied);
    
      
endmodule



